# 图片评估代理配置文件模板
# 复制此文件为 config.yaml 并填入你的 API 信息

# API 配置
api:
  # API 基础 URL（OpenAI 兼容接口）
  # OpenAI 官方: https://api.openai.com/v1
  # Azure OpenAI: https://your-resource.openai.azure.com/openai/deployments/your-deployment
  # 其他代理: 根据提供商文档填写
  base_url: "https://api.openai.com/v1"

  # API Key
  # 从你的 API 提供商获取
  api_key: "your-api-key-here"

  # 模型名称
  # 必须支持视觉功能
  # OpenAI: gpt-4-vision-preview, gpt-4o
  # 其他: 根据提供商文档填写
  model: "gpt-4-vision-preview"

  # 请求超时（秒）
  timeout: 60

  # 最大重试次数
  max_retries: 3

# 图片处理配置
image:
  # 最大图片尺寸（像素）
  # 如果图片超过此尺寸，会自动缩放
  max_size: 2048

  # 图片质量（1-100）
  # 较高的质量会增加文件大小和传输时间
  quality: 85

  # 是否自动调整大小
  auto_resize: true

# 评估配置
evaluation:
  # 评估提示词模板
  # {parameters} 会被替换为实际参数
  prompt_template: |
    你是一个 3D 地形生成专家。请仔细分析这张 Houdini 生成的山脉地形截图，并给出专业评估。

    请从以下方面评估：
    1. **地形高度**: 山脉是否有足够的高度？是否太扁平？
    2. **山脉形状**: 山峰、山谷的形状是否自然？
    3. **整体起伏**: 地形起伏是否明显？是否有层次感？
    4. **细节丰富度**: 是否有足够的细节？
    5. **真实感**: 整体看起来是否像真实的山脉？

    当前参数设置：
    {parameters}

    请给出：
    - 总体评分（1-10分）
    - 各项详细评估
    - 具体的参数调整建议（如果需要改进）

    请用中文回答，格式清晰。

  # 是否保存评估历史
  save_history: true

  # 历史记录目录
  history_dir: "./evaluation_history"

# 日志配置
logging:
  # 日志级别: DEBUG, INFO, WARNING, ERROR
  level: "INFO"

  # 日志文件
  log_file: "./image_evaluator.log"

  # 是否输出到控制台
  console: true
