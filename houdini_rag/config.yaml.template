# Houdini RAG 配置文件模板

# OpenAI 兼容 API 配置
api:
  base_url: "https://api.openai.com/v1"  # 修改为你的API地址
  api_key: "your-api-key-here"  # 修改为你的API密钥
  model: "gpt-3.5-turbo"  # 使用的模型
  embedding_model: "text-embedding-ada-002"  # embedding模型

# 文档爬取配置
scraper:
  base_url: "https://www.sidefx.com/docs/houdini/"
  max_pages: 100  # 最大爬取页面数
  delay: 1.0  # 请求间隔(秒)
  output_dir: "./data/raw"

# 向量数据库配置
vectordb:
  persist_directory: "./data/chroma"
  collection_name: "houdini_docs"
  chunk_size: 1000  # 文本分块大小
  chunk_overlap: 200  # 分块重叠

# RAG 配置
rag:
  top_k: 5  # 检索top-k个相关文档
  temperature: 0.7
  max_tokens: 2000
